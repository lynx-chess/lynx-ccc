{
  "GeneralSettings": {
    "EnableLogging": true
  },

  "EngineSettings": {
    "ShowWDL": true,
    "EstimateMultithreadedSearchNPS": true,
    "WarmupBenchDepth": 9
  },

  "NLog": {
    "variables": {
      "logDirectory": "${basedir}/logs"
    },

    "rules": {
      "0": {
        "logger": "*",
        "minLevel": "Warn",
        "writeTo": "errors"
      },

      "1": {
        "logger": "*",
        "minLevel": "Off",
        "writeTo": "logs"
      }
    }
  }
}
